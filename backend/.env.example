# Environment: development, staging, production
ENVIRONMENT=development
PROJECT_NAME="Tracker API"

# Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tracker_db

# Auth & JWT
JWT_SECRET=tracker-dev-secret-change-in-production-min32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
