# Root / Shared Environment Reference
# Copy frontend/.env.example to frontend/.env.local
# Copy backend/.env.example to backend/.env

# Local Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tracker_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tracker_db

# Backend API & Auth
NEXT_PUBLIC_API_URL=http://localhost:8100
BACKEND_CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
ENVIRONMENT=development
JWT_SECRET=tracker-dev-secret-change-in-production-min32chars
