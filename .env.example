# Root / Shared Environment Reference
# Copy frontend/.env.example to frontend/.env.local
# Copy backend/.env.example to backend/.env

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database (PostgreSQL / Supabase connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tracker_db

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8100
BACKEND_CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
ENVIRONMENT=development
